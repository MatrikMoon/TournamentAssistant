<!-- Thanks in part to BeatSaberMultiplayer's genius UI -->
<vertical xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
          xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/ https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <pg-button dir='Up' click-event='song-list#PageUp'/>
  <custom-list visible-cells='6' cell-size='10' id='song-list' contents='maps' select-cell='song-selected'>
    <horizontal horizontal-fit='PreferredSize' vertical-fit='Unconstrained' child-expand-height='false'>
      <horizontal pref-width='10' pref-height='10' pad='1'
                  child-expand-width='false' child-expand-height='false'>
        <img id='cover-image' preserve-aspect='true' pref-width='8' pref-height='8' />
      </horizontal>
      <stack pref-width='50' pref-height='10'>
        <img id='hover-bg' ignore-layout='true' />
        <raw-image id='loading-bg' ignore-layout='true' />
        <horizontal min-width='50' pad-left='1' pad-right='1' spacing='1' child-expand-height='false'>
          <vertical min-width='39'>
            <text id='song-name-text' font-size='4' align='Left' />
            <text id='song-details-text' font-size='2.8' align='Left'/>
          </vertical>
          <vertical min-width='8' child-control-height='true' child-expand-height='false' spacing='0'>
            <text id='song-duration-text' font-size='4' align='Right' />
            <horizontal min-width='8' pref-height='4' child-control-height='true' child-expand-height='false'
                        child-expand-width='false' child-align='MiddleRight' spacing='0'>
              <img id='song-bpm-icon' preserve-aspect='true' pref-width='2.5' pref-height='2.5' />
              <text id='song-bpm-text' font-size='2.5' align='Right' />
            </horizontal>
          </vertical>
        </horizontal>
      </stack>
    </horizontal>
  </custom-list>
  <pg-button dir='Down' click-event='song-list#PageDown'/>
</vertical>
