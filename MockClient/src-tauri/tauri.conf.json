{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TournamentAssistant Mock Client",
  "version": "0.1.0",
  "identifier": "net.tournamentassistant.mockclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "TournamentAssistant Mock Client",
      "width": 1320,
      "height": 860,
      "minWidth": 980,
      "minHeight": 680,
      "backgroundColor": "#100b18"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["../../TournamentAssistantUI/src-tauri/icons/icon.png"]
  }
}
